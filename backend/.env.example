# Copy this file to ".env" and fill it in. Never commit the real .env.

NODE_ENV=development

# Identity of this process. The npm scripts start:a / start:b / start:c override
# NODE_ID and PORT, so these two only matter for "npm start" and "npm run dev".
NODE_ID=NODE_A
PORT=3001

# 127.0.0.1 keeps the API reachable from this machine only.
# Use 0.0.0.0 if you want to demo from a phone or another laptop on the same Wi-Fi.
HOST=127.0.0.1

# If your PostgreSQL password contains characters such as @ : / # ? % you must
# percent-encode them (for example "@" becomes "%40").
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/campusconnect
REDIS_URL=redis://localhost:6379

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# All three nodes MUST share the same value, otherwise a token issued by one
# node is rejected by the others.
JWT_ACCESS_SECRET=

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of browser origins allowed to call the API and open sockets.
CORS_ORIGINS=http://localhost:5173

# Refresh-token cookie. "lax" is correct while the frontend and the nodes are on
# localhost. If you deploy the frontend on a different site than the API, use
# COOKIE_SAMESITE=none (this also requires HTTPS / COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Number of reverse proxies in front of the node (0 when running directly).
TRUST_PROXY=0

# Optional: only allow sign-ups from these email domains, e.g. students.uni.ac.ke,uni.ac.ke
# ALLOWED_EMAIL_DOMAINS=

DB_POOL_MAX=10

# The address people open in their browser. Used in password-reset and welcome emails.
# Defaults to the first CORS origin.
# APP_URL=http://localhost:5173

# Email (password reset, new-account details). Leave SMTP_HOST empty in development:
# the message, including the reset link, is then printed in this server's console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Elimu <no-reply@your-university.ac.ke>
# SMTP_SECURE=false
