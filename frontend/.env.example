# Copy to ".env" if you need to change the defaults.

# The chat nodes, as NAME=URL pairs. Use "localhost" (not 127.0.0.1) so the
# refresh-token cookie is shared between the page and every node.
VITE_NODES=NODE_A=http://localhost:3001,NODE_B=http://localhost:3002,NODE_C=http://localhost:3003

# Optional health-aware node picker (see /gateway). Leave empty to skip it:
# the browser then probes each node's /api/health itself.
VITE_GATEWAY_URL=http://localhost:4000
